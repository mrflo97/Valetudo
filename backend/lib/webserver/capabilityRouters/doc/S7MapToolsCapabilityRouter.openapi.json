{
  "/api/v2/robot/capabilities/S7MapToolsCapability": {
    "get": {
      "tags": [
        "S7MapToolsCapability"
      ],
      "summary": "Get S7 saved maps, dock and operation state",
      "responses": {
        "200": {
          "description": "State"
        }
      }
    },
    "put": {
      "tags": [
        "S7MapToolsCapability"
      ],
      "summary": "Save, restore or edit an S7 map",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": [
                        "save"
                      ]
                    },
                    "slot": {
                      "type": "string",
                      "enum": [
                        "a",
                        "b"
                      ]
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 48
                    }
                  },
                  "required": [
                    "action",
                    "slot",
                    "name"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": [
                        "restore"
                      ]
                    },
                    "slot": {
                      "type": "string",
                      "enum": [
                        "a",
                        "b"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-f0-9-]{36}$"
                    }
                  },
                  "required": [
                    "action",
                    "slot",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": [
                        "recover"
                      ]
                    }
                  },
                  "required": [
                    "action"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": [
                        "retry_reboot"
                      ]
                    }
                  },
                  "required": [
                    "action"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": [
                        "move_dock"
                      ]
                    },
                    "token": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "mapId": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 62
                    },
                    "dx": {
                      "type": "number",
                      "minimum": -5120,
                      "maximum": 5120
                    },
                    "dy": {
                      "type": "number",
                      "minimum": -5120,
                      "maximum": 5120
                    },
                    "rotation": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180,
                      "description": "Clockwise rotation in degrees relative to the preview. Omit or use zero to preserve the exact original angle."
                    }
                  },
                  "required": [
                    "action",
                    "token",
                    "mapId",
                    "dx",
                    "dy"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Operation result"
        },
        "202": {
          "description": "Applied; reboot follows"
        },
        "400": {
          "description": "Invalid request"
        }
      }
    }
  },
  "/api/v2/robot/capabilities/S7MapToolsCapability/slots/{slot}/preview": {
    "get": {
      "tags": [
        "S7MapToolsCapability"
      ],
      "summary": "Read saved map preview",
      "parameters": [
        {
          "in": "path",
          "name": "slot",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "a",
              "b"
            ]
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Saved map preview"
        }
      }
    }
  },
  "/api/v2/robot/capabilities/S7MapToolsCapability/slots/{slot}/download": {
    "get": {
      "tags": [
        "S7MapToolsCapability"
      ],
      "summary": "Read saved map download",
      "parameters": [
        {
          "in": "path",
          "name": "slot",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "a",
              "b"
            ]
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Saved map download"
        }
      }
    }
  }
}
